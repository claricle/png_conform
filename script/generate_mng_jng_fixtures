#!/usr/bin/env ruby
# frozen_string_literal: true

# Builds the synthetic MNG/JNG fixtures under spec/fixtures/{mng,jng}.
# Every byte is produced here (the JPEG payload is generated by ImageMagick
# from a flat gray canvas), so the files are original works of this project.
# Usage: script/generate_mng_jng_fixtures [--check]

require "zlib"
require "open3"
require "fileutils"

ROOT = File.expand_path("..", __dir__)
MNG_SIG = [0x8a, 0x4d, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a].pack("C*")
JNG_SIG = [0x8b, 0x4a, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a].pack("C*")
PNG_SIG = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a].pack("C*")

def chunk(type, data = "".b, crc: nil)
  data = data.b
  crc ||= Zlib.crc32(type + data)
  [data.bytesize].pack("N") + type + data + [crc].pack("N")
end

def jpeg
  out, status = Open3.capture2("magick", "-size", "8x8", "xc:gray50",
                               "-strip", "-sampling-factor", "4:2:0",
                               "-quality", "75", "-interlace", "none",
                               "-define", "jpeg:optimize-coding=false",
                               "jpeg:-", binmode: true)
  abort "magick failed" unless status.success?
  out
end

def mhdr(width: 8, height: 8)
  [width, height, 1, 1, 1, 1, 0].pack("N7")
end

def jhdr(width: 8, height: 8, color: 10, depth: 8, comp: 8, alpha: 0)
  fields = [color, depth, comp, 0, alpha, alpha.zero? ? 0 : 8, 0, 0]
  [width, height].pack("NN") + fields.pack("C8") + ("\0" * 4)
end

def png_ihdr
  [8, 8, 8, 0, 0, 0, 0].pack("NNC5")
end

def gray_idat
  Zlib::Deflate.deflate(([0] + ([128] * 8)).pack("C*") * 8)
end

JPG = jpeg
FILES = {
  "mng/valid-minimal.mng" => MNG_SIG + chunk("MHDR", mhdr) + chunk("MEND"),
  "mng/valid-embedded-png.mng" => MNG_SIG + chunk("MHDR", mhdr) +
    chunk("IHDR", png_ihdr) + chunk("IDAT", gray_idat) + chunk("IEND") + chunk("MEND"),
  "mng/invalid-missing-mend.mng" => MNG_SIG + chunk("MHDR", mhdr) +
    chunk("IHDR", png_ihdr) + chunk("IDAT", gray_idat) + chunk("IEND"),
  "mng/invalid-mhdr-not-first.mng" => MNG_SIG + chunk("TERM", [3, 0, 0, 0, 0, 0, 0, 0, 0, 0].pack("C*")) +
    chunk("MHDR", mhdr) + chunk("MEND"),
  "mng/invalid-zero-dimensions.mng" => MNG_SIG + chunk("MHDR", mhdr(width: 0, height: 0)) + chunk("MEND"),
  "mng/invalid-bad-crc.mng" => MNG_SIG + chunk("MHDR", mhdr, crc: 0) + chunk("MEND"),
  "jng/valid-minimal.jng" => JNG_SIG + chunk("JHDR", jhdr) + chunk("JDAT", JPG) + chunk("IEND"),
  "jng/valid-alpha.jng" => JNG_SIG + chunk("JHDR", jhdr(color: 12, alpha: 8)) +
    chunk("JDAT", JPG) + chunk("IDAT", gray_idat) + chunk("IEND"),
  "jng/invalid-missing-jdat.jng" => JNG_SIG + chunk("JHDR", jhdr) + chunk("IEND"),
  "jng/invalid-missing-iend.jng" => JNG_SIG + chunk("JHDR", jhdr) + chunk("JDAT", JPG),
  "jng/invalid-compression-method.jng" => JNG_SIG + chunk("JHDR", jhdr(comp: 1)) +
    chunk("JDAT", JPG) + chunk("IEND"),
  "jng/invalid-color-type.jng" => JNG_SIG + chunk("JHDR", jhdr(color: 9)) +
    chunk("JDAT", JPG) + chunk("IEND"),
}.freeze

check = ARGV == ["--check"]
abort "unknown option" unless ARGV.empty? || check
stale = FILES.reject do |rel, bytes|
  path = File.join(ROOT, "spec/fixtures", rel)
  File.binread(path) == bytes if File.exist?(path)
end
if check
  # The JPEG payload comes from the local ImageMagick build; --check is a
  # convenience for the generating machine, the checked-in bytes are canonical.
  puts stale.empty? ? "fixtures match" : "differs: #{stale.keys.join(', ')}"
  exit(stale.empty? ? 0 : 1)
end
FILES.each do |rel, bytes|
  path = File.join(ROOT, "spec/fixtures", rel)
  FileUtils.mkdir_p(File.dirname(path))
  File.binwrite(path, bytes)
end
puts "wrote #{FILES.size} fixtures"
